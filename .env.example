# Optional Python executable override used by the TypeScript/Python bridge.
# Windows example: C:\\Python313\\python.exe
# Linux/macOS example: /usr/bin/python3
FEM_PYTHON=

# Pi provider credentials are managed by Pi/provider configuration and must not be committed here.
# Set to 1 when you explicitly want Pi startup to avoid network update/telemetry checks.
PI_OFFLINE=0

# Optional EngiKnow knowledge integration harness.
# Leave both values empty for the default fail-closed state.
# PR20 supports only explicit fixture mode; it is NOT live RAGFlow retrieval.
# Example fixture: tests/fixtures/knowledge/seismic-time-history.json
ENGIKNOW_KNOWLEDGE_MODE=
ENGIKNOW_KNOWLEDGE_FIXTURE=
